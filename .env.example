# Local defaults. Copy to .env before changing anything.
# Do not put production secrets in this file. .env is gitignored.

# Postgres (docker compose). The password below is a local-only default.
POSTGRES_USER=auditmaster
POSTGRES_PASSWORD=auditmaster
POSTGRES_DB=auditmaster

# Used by the API when it runs on the host. Inside Compose, the service
# overrides the host to `db`.
DATABASE_URL=postgresql://auditmaster:auditmaster@localhost:5432/auditmaster

# true: deterministic fake chat JSON and hashed embeddings. No API key and
# no model server. This is the Compose default so the RCM flow runs locally.
# Set to false to call the OpenAI-compatible endpoints below.
FAKE_MODELS=true

# OpenAI-compatible chat. Hosted open-weight server now, vLLM or Ollama
# on-prem later. The value should include the /v1 prefix the server expects.
# Local servers that ignore auth still need a non-empty placeholder.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=local-dev
OPENAI_MODEL=local-model

# Embeddings. Empty EMBEDDING_BASE_URL uses OPENAI_BASE_URL.
# The database stores 1024-dimensional vectors (BGE-M3 / BAAI/bge-m3).
# EMBEDDING_MODE=local uses sentence-transformers instead of HTTP.
EMBEDDING_MODE=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# Optional self-hosted reranker (Hugging Face TEI /rerank).
# POST {"query","texts"} -> [{"index","score"}]. Empty disables it.
RERANKER_URL=

# Browser origin allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Baked into the web client at build time. The browser calls this URL,
# so it must be reachable from the machine running the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local upload storage; Compose uses its persistent /data volume.
DATA_DIR=./data
